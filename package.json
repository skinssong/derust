{
  "name": "derust",
  "displayName": "Derust",
  "description": "AI-generated readings of Rust: a project view with an opening line, run flow and reading order, plus per-file module readings, spotlights and ownership.",
  "version": "0.9.0",
  "publisher": "rsong",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skinssong/derust.git"
  },
  "homepage": "https://github.com/skinssong/derust#readme",
  "bugs": {
    "url": "https://github.com/skinssong/derust/issues"
  },
  "activationEvents": [
    "workspaceContains:**/*.rs",
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Education",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "rust",
    "ownership",
    "explain",
    "ai",
    "learning"
  ],
  "main": "./out/src/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "index:spike": "node scripts/index-spike.js",
    "profile:spike": "node scripts/profile-smoke.js",
    "package:vsix": "npm run compile && mkdir -p release && npx @vscode/vsce package --allow-missing-repository --out release/derust-${npm_package_version}.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "derust.analyzeFile",
        "title": "Derust: Read & Analyze Current File",
        "icon": "$(book)"
      },
      {
        "command": "derust.analyzePath",
        "title": "Derust: Analyze Path…"
      },
      {
        "command": "derust.analyzeWorkspace",
        "title": "Derust: Analyze Workspace"
      },
      {
        "command": "derust.openPanel",
        "title": "Derust: Open Panel",
        "icon": "$(preview)"
      },
      {
        "command": "derust.showOverview",
        "title": "Derust: Show File Overview",
        "icon": "$(list-tree)"
      },
      {
        "command": "derust.rebuildIndex",
        "title": "Derust: Rebuild Workspace Index",
        "icon": "$(refresh)"
      },
      {
        "command": "derust.showIndexPacket",
        "title": "Derust: Show Index Packet",
        "icon": "$(output)"
      },
      {
        "command": "derust.configureProvider",
        "title": "Derust: Configure Provider",
        "icon": "$(settings-gear)"
      },
      {
        "command": "derust.clearCache",
        "title": "Derust: Clear Analysis Cache",
        "icon": "$(trash)"
      },
      {
        "command": "derust.analyzeArchitecture",
        "title": "Derust: Analyze Architecture",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "derust.analyzeFile",
          "when": "resourceLangId == rust",
          "group": "navigation@1"
        },
        {
          "command": "derust.openPanel",
          "when": "resourceLangId == rust",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "derust.analyzeFile",
          "when": "resourceExtname == .rs",
          "group": "7_derust@1"
        },
        {
          "command": "derust.analyzePath",
          "when": "explorerResourceIsFolder",
          "group": "7_derust@2"
        }
      ],
      "commandPalette": [
        {
          "command": "derust.analyzeFile"
        },
        {
          "command": "derust.analyzePath"
        },
        {
          "command": "derust.analyzeWorkspace"
        },
        {
          "command": "derust.analyzeArchitecture"
        },
        {
          "command": "derust.openPanel"
        },
        {
          "command": "derust.showOverview"
        },
        {
          "command": "derust.rebuildIndex"
        },
        {
          "command": "derust.showIndexPacket"
        },
        {
          "command": "derust.configureProvider"
        },
        {
          "command": "derust.clearCache"
        }
      ]
    },
    "keybindings": [
      {
        "command": "derust.analyzeFile",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == rust"
      }
    ],
    "configuration": {
      "title": "Derust",
      "properties": {
        "derust.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible provider base URL, for example https://api.openai.com/v1. The extension POSTs to <baseUrl>/chat/completions. Set it here or with Derust: Configure Provider."
        },
        "derust.model": {
          "type": "string",
          "default": "",
          "description": "Model id sent to the configured provider."
        },
        "derust.jsonMode": {
          "type": "boolean",
          "default": true,
          "description": "Send response_format: {type: \"json_object\"}. Falls back automatically if the provider rejects it."
        },
        "derust.timeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "description": "Timeout for one analysis request."
        },
        "derust.maxOutputTokens": {
          "type": "number",
          "default": 32768,
          "minimum": 1024,
          "description": "Output token cap. Reasoning models spend part of this budget on thinking before writing JSON."
        },
        "derust.reasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ],
          "default": "low",
          "description": "Reasoning effort sent to the provider. Dropped automatically if the provider rejects it."
        },
        "derust.maxFileLines": {
          "type": "number",
          "default": 1200,
          "minimum": 50,
          "description": "Files longer than this are refused. Increase it for large modules; cost and truncation risk rise with size."
        },
        "derust.includeDocs": {
          "type": "boolean",
          "default": true,
          "description": "Include DESIGN.md, README.md and Cargo.toml from the workspace root as project context."
        },
        "derust.concurrency": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Files analyzed in parallel for folder/workspace runs."
        },
        "derust.maxFiles": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Ask for confirmation when a multi-file run exceeds this count."
        },
        "derust.defaultLayout": {
          "type": "string",
          "enum": [
            "cards",
            "columns"
          ],
          "default": "cards",
          "description": "Default spotlight layout."
        },
        "derust.autoAnalyze": {
          "type": "boolean",
          "default": true,
          "description": "Start Read & Analyze automatically when a file's Derust view opens; cached results are reused."
        },
        "derust.restoreLastAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Reopen the last file's cached analysis or brief when VS Code starts."
        },
        "derust.colorCode": {
          "type": "boolean",
          "default": true,
          "description": "Color identifiers in the editor to match the memory timeline lanes."
        },
        "derust.overviewGlance": {
          "type": "boolean",
          "default": true,
          "description": "Show a one-line overview above the first line of Rust files. Click it to open the Overview tab."
        },
        "derust.briefOnOverview": {
          "type": "boolean",
          "default": true,
          "description": "When derust.autoAnalyze is off, start just the AI module reading when the file overview opens. With auto analysis on, Read & Analyze covers it."
        }
      }
    }
  },
  "dependencies": {
  }
}
